<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- FRONT BUMPER LINK -->
    <link name="front_bumper_link">

        <visual name="front_bumper_visual">
            <geometry>
                <box size="0.04 0.50 0.10"/>
            </geometry>

            <material name="bumper_red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
        </visual>

        <collision name="front_bumper_collision">
            <geometry>
                <box size="0.04 0.50 0.10"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="0.1"/>

            <inertia
                ixx="0.0021"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0021"/>
        </inertial>

    </link>

    <!-- BUMPER JOINT -->
    <joint name="front_bumper_joint" type="fixed">

        <parent link="base_link"/>
        <child link="front_bumper_link"/>

        <origin xyz="0.43 0 0" rpy="0 0 0"/>

    </joint>

    <!-- Prevent fixed joint lumping in Gazebo -->
    <gazebo reference="front_bumper_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- GAZEBO CONTACT SENSOR -->
    <gazebo reference="front_bumper_link">

        <sensor name="front_contact_sensor" type="contact">

            <always_on>true</always_on>

            <update_rate>50</update_rate>

            <topic>/contact</topic>

            <contact>
                <collision>front_bumper_link_fixed_joint_lump__front_bumper_collision_collision</collision>
            </contact>

        </sensor>

    </gazebo>

</robot>