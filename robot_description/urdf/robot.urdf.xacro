<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">

  <!-- IMU sensor definition -->
  <xacro:include filename="$(find robot_description)/urdf/imu.xacro"/>

  <!-- ==================== MATERIALS ==================== -->

  <material name="pink">
    <color rgba="1.0 0.2 0.6 1.0"/>
  </material>

  <material name="dark_pink">
    <color rgba="0.75 0.05 0.3 1.0"/>
  </material>

  <!-- ==================== BASE FOOTPRINT ==================== -->

  <link name="base_footprint"/>

  <!-- ==================== MAIN BODY ==================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.60 0.20"/>
      </geometry>
      <material name="pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.80 0.60 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.1667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.2833"
        iyz="0.0"
        izz="0.4167"/>
    </inertial>

  </link>

  <joint name="base_fixed_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LEFT WHEEL ==================== -->

  <link name="left_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.04"/>
      </geometry>
      <material name="dark_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.0005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00096"
        iyz="0.0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.32 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== RIGHT WHEEL ==================== -->

  <link name="right_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.04"/>
      </geometry>
      <material name="dark_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.0005"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00096"
        iyz="0.0"
        izz="0.0005"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.32 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ==================== REAR CASTER ==================== -->

  <link name="caster_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="dark_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.000018"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000018"
        iyz="0.0"
        izz="0.000018"/>
    </inertial>

  </link>

  <joint name="caster_fixed_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="caster_link"/>
    <origin xyz="-0.30 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ==================== FRONT CASTER ==================== -->

  <link name="front_caster_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="dark_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.000018"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000018"
        iyz="0.0"
        izz="0.000018"/>
    </inertial>

  </link>

  <joint name="front_caster_fixed_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="front_caster_link"/>
    <origin xyz="0.30 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- ==================== LIDAR PLACEHOLDER ==================== -->

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
      <material name="dark_pink"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="lidar_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- ==================== GAZEBO MATERIALS ==================== -->

  <gazebo reference="base_link">
    <material>Gazebo/Pink</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkPink</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkPink</material>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/DarkPink</material>
  </gazebo>

  <gazebo reference="front_caster_link">
    <material>Gazebo/DarkPink</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/DarkPink</material>
  </gazebo>

  <!-- ==================== DIFFERENTIAL DRIVE ==================== -->

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.64</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <topic>/cmd_vel</topic>

      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>

    </plugin>
  </gazebo>

</robot>